{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tachyon",
  "version": "0.2.7",
  "identifier": "com.ayush18.tachyon",
  "build": {
    "beforeDevCommand": "sh ui/build-web.sh",
    "beforeBuildCommand": "sh ui/build-web.sh --release",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tachyon",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ayushap18/tachyon/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGQzQ0Q0M1MDg1NDdFNjQKUldSa2ZsUUl4VXpFVCsvalNIenBseHFsYmF4dU1tN3B1Z2M3K1hBWWtHcFE5eGhuUUtSSkYzdDgK"
    }
  }
}
