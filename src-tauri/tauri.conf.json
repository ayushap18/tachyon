{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tachyon",
  "version": "0.2.4",
  "identifier": "com.ayush18.tachyon",
  "build": {
    "beforeDevCommand": "sh ui/build-web.sh",
    "beforeBuildCommand": "sh ui/build-web.sh --release",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tachyon",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
